{
  "name": "masterland",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8084",
    "ios": "expo run:ios --port 8084",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:test": "EXPO_PUBLIC_TEST_MODE=true expo start --port 8084",
    "ios:test": "EXPO_PUBLIC_DISTRIBUTION_CHANNEL=local EXPO_PUBLIC_TEST_MODE=true expo run:ios --configuration Release --port 8084",
    "ios:production": "EXPO_PUBLIC_DISTRIBUTION_CHANNEL=production EXPO_PUBLIC_TEST_MODE=false expo run:ios --configuration Release --port 8084",
    "ios:beta": "EXPO_PUBLIC_DISTRIBUTION_CHANNEL=testflight EXPO_PUBLIC_TEST_MODE=true expo run:ios --configuration Release --port 8084"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-iap": "^6.5.0",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
