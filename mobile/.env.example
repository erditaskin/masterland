# Public mobile configuration only. Never add service-role keys or OAuth client secrets here.
EXPO_PUBLIC_BACKEND_ENABLED=false
EXPO_PUBLIC_BACKEND_ENV=disabled
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_LOGIN_ENABLED=false
# Existing build flags remain independent. Test builds cannot connect to a production backend.
EXPO_PUBLIC_TEST_MODE=false
EXPO_PUBLIC_DISTRIBUTION_CHANNEL=local
