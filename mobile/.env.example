# Public mobile configuration only. Never add session tokens or OAuth client secrets here.
EXPO_PUBLIC_BACKEND_ENABLED=false
EXPO_PUBLIC_BACKEND_ENV=disabled
EXPO_PUBLIC_API_URL=https://api.masterland.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_LOGIN_ENABLED=false
# Existing build flags remain independent. Test builds cannot connect to a production backend.
EXPO_PUBLIC_TEST_MODE=false
EXPO_PUBLIC_DISTRIBUTION_CHANNEL=local

# Opt-in; only test inventory/rewards are currently enabled in code.
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_AD_UNIT_ID=

# Remains disabled until server deletion/provider revocation/device acceptance.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false

# Separate fresh save for controlled TestFlight account acceptance.
EXPO_PUBLIC_CONTROLLED_ACCEPTANCE=false
EXPO_PUBLIC_ADMOB_IOS_PRODUCER_REWARDED_AD_UNIT_ID=

# 17 Nov: verified server rewards now have an explicit opt-in path; the earlier test-only note is historical.
# Requires non-test production or controlled TestFlight, our own AdMob units and the server gate.
EXPO_PUBLIC_VERIFIED_REWARDS_ENABLED=false
# Optional comma-separated Google SDK test-device hashes; never session tokens or device passwords.
# For acceptance, Masterland 0.2.0 is also registered in AdMob app-level test mode.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
